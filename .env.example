# Database Connection URL (PostgreSQL Enterprise)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:password_anda@localhost:5432/db_mis"

# Master Security Credentials (Default fallback jika belum diatur di database)
FINANCE_PASSWORD_DEFAULT="keuangan123"
MANAGEMENT_MASTER_PASSWORD_DEFAULT="admin123"
